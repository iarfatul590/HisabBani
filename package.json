{
  "name": "hisabbani-fintech-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp-first digital ledger MVP for small retailers in Bangladesh",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/jobs/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/jobs/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "onboard:shop": "tsx src/scripts/onboard-shop.ts",
    "reminders:schedule": "tsx src/jobs/schedule-reminders.ts"
  },
  "engines": { "node": ">=20.11" },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bullmq": "^5.41.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "ioredis": "^5.4.2",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}