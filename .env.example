NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hisabbani?schema=public
REDIS_URL=redis://localhost:6379

META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-a-long-random-webhook-token
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DUE_REMINDER_TEMPLATE=due_reminder_bn

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_STT_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
ENABLE_VOICE_REPLIES=true
AUTO_POST_CONFIDENCE=0.88
MAX_AUDIO_BYTES=16000000
REMINDER_TIMEZONE=Asia/Dhaka